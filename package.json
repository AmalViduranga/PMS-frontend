{
  "name": "pharmaflow-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve web --port 4200",
    "start:web": "ng serve web --port 4200",
    "start:storefront": "ng serve storefront --port 4201",
    "build": "ng build web && ng build storefront",
    "build:web": "ng build web",
    "build:storefront": "ng build storefront",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.html"
  },
  "dependencies": {
    "@angular/animations": "18.2.11",
    "@angular/cdk": "18.2.11",
    "@angular/common": "18.2.11",
    "@angular/compiler": "18.2.11",
    "@angular/core": "18.2.11",
    "@angular/forms": "18.2.11",
    "@angular/material": "18.2.11",
    "@angular/platform-browser": "18.2.11",
    "@angular/platform-browser-dynamic": "18.2.11",
    "@angular/router": "18.2.11",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/build": "18.2.11",
    "@angular/cli": "18.2.11",
    "@angular/compiler-cli": "18.2.11",
    "eslint": "^8.57.1",
    "typescript": "~5.5.4",
    "typescript-eslint": "^7.18.0"
  }
